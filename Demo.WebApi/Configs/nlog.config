<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off">

  <targets>
    <target name="info" xsi:type="File"
            openFileCacheTimeout="3600"
            fileName="${basedir}/Logs/Log-${date:universalTime=false:format=yyyyMMdd}-Info.log"
            deleteOldFileOnStartup="false"
            layout="${longdate} [${level:uppercase=true}] ${callsite:className=true:methodName=true:fileName=false:skipFrames=2} ${message}" />

    <target name="error" xsi:type="File"
            openFileCacheTimeout="3600"
            fileName="${basedir}/Logs/Log-${date:universalTime=false:format=yyyyMMdd}-Error.log"
            deleteOldFileOnStartup="false"
            layout="${longdate} [${level:uppercase=true}] ${callsite:className=true:methodName=true:fileName=false:skipFrames=2} ${message} ${newline} ${exception:format=tostring}" />

    <target name="console" xsi:type="Console"
            layout="${longdate} [${level:uppercase=true}] ${message}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" maxlevel="Info" writeTo="info" />
    <logger name="*" minlevel="Warn" writeTo="error" />
    <logger name="*" minlevel="Warn" writeTo="console" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Debug" writeTo="console" />
  </rules>
</nlog>
