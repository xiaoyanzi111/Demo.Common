{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  "//": "=========== JWT 配置 ===========",
  "JwtSetting": {
    "ValidIssuer": "demo.com",
    "ValidAudience": "demo.com.receiver",
    "IssuerSigningKey": "demo.com.2026.please.change.this.key.at.least.32.chars",
    "ExpireMinutes": 120
  },

  "//Startup": "=========== 启动项配置 ===========",
  "Startup": {
    "AllowOrigins": "http://localhost:5173|http://localhost:8080|http://127.0.0.1:5173"
  },

  "//DBS": "=========== 数据库配置（SQL Server）===========",
  "DBS": {
    "MainDB": "MainDb",
    "MutiDBEnabled": false,
    "ConnectionEncrypt": false,
    "MutiDBConns": [
      {
        "ConnId": "MainDb",
        "DBType": 1,
        "Enabled": true,
        "HitRate": 20,
        "Connection": "Server=127.0.0.1,1433;Database=DemoDb;User Id=sa;Password=your_password;TrustServerCertificate=True;Encrypt=False;Pooling=true;Max Pool Size=100;"
      }
    ]
  },

  "//AppSettings": "=========== 业务应用相关配置 ===========",
  "AppSettings": {
    "WebSessionExpire": 12,
    "MiniProgramSessionExpire": 24
  }
}
